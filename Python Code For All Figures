    plot_skewed_manifold(out)
    plot_potential_descent(out, diagnostics)
    plot_geometric_convergence(out, diagnostics, constants)
    plot_reaction_curves(out)
    heatmap_metrics = plot_heatmap(out, truth, baseline, proposed)
