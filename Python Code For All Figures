    ax.scatter(*ne, color="black", marker="s", s=22, zorder=5, label="NE")
    ax.scatter(*se, color=PURPLE, marker="*", s=48, zorder=6, label="SE")
    ax.set(xlabel="Leader strategy $y$", ylabel="Follower strategy $x$",
