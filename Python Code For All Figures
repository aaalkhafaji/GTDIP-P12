def scalar_parameters():
    return {"I_R": 0.625, "I_G": 0.8, "lambda_R": 1.5,
            "lambda_G": 1.0, "gamma": 1.0}


def scalar_equilibria(p):
    ir, ig = p["I_R"], p["I_G"]
    lr, lg, gamma = p["lambda_R"], p["lambda_G"], p["gamma"]
    a = lr / (lr + gamma)
    y_se = (lg * ig + gamma * a * a * ir) / (lg + gamma * a * a)
    x_se = a * ir + (1 - a) * y_se
    mat = np.array([[lr + gamma, -gamma], [-gamma, lg + gamma]])
    x_ne, y_ne = np.linalg.solve(mat, np.array([lr * ir, lg * ig]))
    return a, (y_ne, x_ne), (y_se, x_se)


def plot_bilevel_landscape(out: Path) -> None:
    p = scalar_parameters()
    a, _, se = scalar_equilibria(p)
    y = np.linspace(0, 1, 90)
    x = np.linspace(0, 1, 90)
    yy, xx = np.meshgrid(y, x)
    jl = .5 * p["lambda_G"] * (yy - p["I_G"]) ** 2 + .5 * p["gamma"] * (yy - xx) ** 2
    reaction = a * p["I_R"] + (1 - a) * y
    jl_reaction = .5 * p["lambda_G"] * (y - p["I_G"]) ** 2 + .5 * p["gamma"] * (y - reaction) ** 2

    fig = plt.figure(figsize=(SINGLE, 2.65))
    ax = fig.add_subplot(111, projection="3d")
    ax.plot_surface(yy, xx, jl, cmap="viridis", alpha=.58, linewidth=0, antialiased=True)
    ax.plot(y, reaction, jl_reaction, color="#00BFC4", lw=2.2,
            label=r"reaction manifold $x^\star(y)$")
    zse = .5 * p["lambda_G"] * (se[0] - p["I_G"]) ** 2 + .5 * p["gamma"] * (se[0] - se[1]) ** 2
    ax.scatter(*se, zse, color=ORANGE, s=25, depthshade=False, label="Stackelberg point")
    ax.set_xlabel("Leader $y$", labelpad=-1)
    ax.set_ylabel("Follower $x$", labelpad=-1)
    ax.set_zlabel(r"$J_L$", labelpad=-1)
    ax.tick_params(pad=-2)
    ax.view_init(elev=24, azim=-130)
    ax.legend(loc="upper left", frameon=True)
    fig.subplots_adjust(left=.01, right=.96, bottom=.02, top=.98)
    save_figure(fig, out, "fig_bilevel_landscape")


