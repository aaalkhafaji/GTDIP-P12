def plot_bilevel_landscape():
    fig = plt.figure(figsize=(9, 7))
    ax = fig.add_subplot(111, projection='3d')
    
    u_g = np.linspace(-2.5, 2.5, 60, dtype=np.float64)
    u_f = np.linspace(-2.5, 2.5, 60, dtype=np.float64)
    X, Y = np.meshgrid(u_g, u_f)
    
    boundary_damping = np.exp(-0.05 * (X**4 + Y**4))
    Z = ((X**2 + 0.5 * Y**2) + 2 * np.sin(X*Y)) * boundary_damping
    
    R_ug = 0.5 * u_g + np.sin(u_g)
    Z_manifold = ((u_g**2 + 0.5 * R_ug**2) + 2 * np.sin(u_g*R_ug)) * np.exp(-0.05 * (u_g**4 + R_ug**4))
    
    ax.plot_surface(X, Y, Z, alpha=0.4, cmap='viridis', edgecolor='none')
    ax.plot(u_g, R_ug, Z_manifold + 0.2, color='cyan', linewidth=4, label=r"Followers' Reaction Manifold $\mathcal{R}_{\mathcal{F}}(g)$", zorder=5)
    
    min_idx = np.argmin(Z_manifold)
    ax.scatter(u_g[min_idx], R_ug[min_idx], Z_manifold[min_idx] + 0.2, color='red', s=150, label='Stackelberg Equilibrium', zorder=10)
    
    ax.set_xlabel(r"Leader Strategy (Guide) $g$")
    ax.set_ylabel(r"Follower Strategy $u_{\mathcal{F}}$")
    ax.set_zlabel(r"Leader Objective $\widehat{J}$")
    ax.set_title("FP64 Bilevel Landscape with Boundary Damping", fontweight='bold')
    ax.legend(loc='upper right')
    ax.view_init(elev=25, azim=135)
    save_fig(fig, "fig_bilevel_landscape.png")
    plt.close()

