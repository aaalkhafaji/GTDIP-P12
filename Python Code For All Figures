    for patch, w in zip(similar_patches, weights):
        ax.add_patch(Rectangle((patch[0] - 1.5, patch[1] - 1.5), 3, 3, fill=True, facecolor='#2ecc71', alpha=0.3, edgecolor='#27ae60', linewidth=1.5))
        ax.scatter(*patch, color='black', s=30, zorder=5)
        ax.plot([ref_center[0], patch[0]], [ref_center[1], patch[1]], color='#3498db', linewidth=w * 5, linestyle='-', zorder=4)
        mid_x = (ref_center[0] + patch[0]) / 2
        mid_y = (ref_center[1] + patch[1]) / 2
        ax.text(mid_x, mid_y + 0.3, rf'$w_{{pq}} = {w:.2f}$', ha='center', color='#2980b9', fontweight='bold', bbox=dict(facecolor='white', edgecolor='none', alpha=0.8, pad=1))
               
    ax.set_title(r"Leader-Induced Symmetric Non-Local Graph ($L_G$)", fontweight='bold', pad=15)
    ax.axis('off')
    save_fig(fig, "fig_nl_graph_topology.png")
    plt.close()

