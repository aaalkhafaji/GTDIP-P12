    configure_style()

    truth, noisy, sigma, weights, guide = synthetic_equal_edge_problem()
    lap = neumann_laplacian(truth.shape[1]).tocsr()
    baseline, _, _ = solve_quadratic_followers(noisy, guide, lap, .20, 0.0, .05)
    proposed, _, _ = solve_quadratic_followers(noisy, guide, lap, .20, 1.0, .05)
    diagnostics, constants = quadratic_diagnostics(noisy, guide, lap)
    diagnostics.to_csv(out / "solver_diagnostics.csv", index=False)

    sure = sure_calibration()
    sure.to_csv(out / "sure_calibration.csv", index=False)

