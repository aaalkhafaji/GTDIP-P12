def plot_geometric_convergence(out: Path, diagnostics: pd.DataFrame, constants: dict) -> None:
    stable = diagnostics.relative_distance.to_numpy()
    envelope = diagnostics.theory_envelope.to_numpy()
    k = diagnostics.iteration.to_numpy()
    # A one-dimensional worst-curvature mode shows what can occur beyond 2/L.
    tau_bad = 2.08 / constants["L"]
    bad_factor = abs(1 - tau_bad * constants["L"])
    bad = bad_factor ** k
    fig, ax = plt.subplots(figsize=(SINGLE, 2.55))
    ax.semilogy(k, envelope, "--", color="black", label=r"proved envelope $q(\tau)^k$")
    ax.semilogy(k, stable, color=BLUE, label="admissible step")
    ax.semilogy(k[:35], bad[:35], "-.", color=ORANGE,
                label=r"inadmissible local mode, $\tau>2/L_P$")
    ax.set(xlabel="iteration $k$", ylabel=r"relative distance to $u^\star$")
    ax.grid(True, which="both", alpha=.24)
    ax.legend(loc="lower left")
    fig.tight_layout(pad=.2)
    save_figure(fig, out, "fig_geometric_convergence")


