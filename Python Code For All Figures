def plot_heatmap(out: Path, truth, baseline, proposed) -> pd.DataFrame:
    base_sam = spectral_angle_map(baseline, truth)
    prop_sam = spectral_angle_map(proposed, truth)
    vmax = float(np.percentile(np.concatenate([base_sam.ravel(), prop_sam.ravel()]), 99))
    fig, axes = plt.subplots(1, 2, figsize=(DOUBLE, 2.35), constrained_layout=True)
    im = axes[0].imshow(base_sam, cmap="cividis", vmin=0, vmax=vmax)
    axes[1].imshow(prop_sam, cmap="cividis", vmin=0, vmax=vmax)
    metrics = []
    for ax, name, data in zip(axes, ["unguided quadratic", "reliability-guided"], [base_sam, prop_sam]):
        mean = float(np.mean(data))
        p95 = float(np.percentile(data, 95))
        metrics.append({"method": name, "mean_sam_deg": mean, "p95_sam_deg": p95})
        ax.set_title(f"{name}\nmean={mean:.2f}°, 95th={p95:.2f}°", fontsize=8)
        ax.set_xticks([])
        ax.set_yticks([])
    cbar = fig.colorbar(im, ax=axes, fraction=.025, pad=.02)
    cbar.set_label("spectral angular error (degrees)")
    save_figure(fig, out, "fig_chromatic_heatmap")
    return pd.DataFrame(metrics)


def plot_convergence_speed(out: Path, diagnostics: pd.DataFrame) -> int:
    residual = diagnostics.gradient_rms.to_numpy()
    tolerance = 1e-8
    hit = np.flatnonzero(residual <= tolerance)
    converged = int(hit[0]) if hit.size else int(diagnostics.iteration.iloc[-1])
    fig, ax = plt.subplots(figsize=(SINGLE, 2.45))
    ax.semilogy(diagnostics.iteration, residual, color=GREEN,
                label="stationarity residual")
    ax.axhline(tolerance, color="black", ls=":", label=r"tolerance $10^{-8}$")
    ax.axvline(converged, color=ORANGE, ls="--", lw=1)
    ax.text(converged + 2, tolerance * 3, f"first hit: $k={converged}$", color=ORANGE)
    ax.set(xlabel="iteration $k$", ylabel=r"$\|\nabla P(u^k)\|_2/\sqrt{CN}$")
    ax.grid(True, which="both", alpha=.24)
    ax.legend(loc="upper right")
    fig.tight_layout(pad=.2)
    save_figure(fig, out, "fig_convergence_speed")
    return converged


def sure_calibration() -> pd.DataFrame:
    rng = np.random.default_rng(SEED + 7)
    n = 128
    t = np.linspace(0, 1, n)
    truth = .45 + .20 * np.sin(2 * np.pi * t) + .12 * np.sin(8 * np.pi * t)
    d = np.zeros((n - 1, n))
    rows = np.arange(n - 1)
    d[rows, rows] = -1
    d[rows, rows + 1] = 1
    lap = d.T @ d
    eigval, eigvec = eigh(lap)
    sigma = .18
    gammas = np.geomspace(.01, 30, 55)
    replications = 250
    mse = np.empty((replications, len(gammas)))
    sure = np.empty_like(mse)
    for r in range(replications):
        y = truth + rng.normal(0, sigma, n)
        coeff = eigvec.T @ y
        for j, gamma in enumerate(gammas):
            filt = 1 / (1 + gamma * eigval)
            estimate = eigvec @ (filt * coeff)
            mse[r, j] = np.mean((estimate - truth) ** 2)
            sure[r, j] = (np.mean((estimate - y) ** 2) - sigma ** 2
                          + 2 * sigma ** 2 * np.mean(filt))
    rows = []
    for j, gamma in enumerate(gammas):
        rows.append({
            "gamma": gamma,
            "mean_mse": mse[:, j].mean(),
            "mse_se": mse[:, j].std(ddof=1) / np.sqrt(replications),
            "mean_sure": sure[:, j].mean(),
            "sure_se": sure[:, j].std(ddof=1) / np.sqrt(replications),
        })
    return pd.DataFrame(rows)


def plot_sure(out: Path, data: pd.DataFrame) -> None:
    g = data.gamma.to_numpy()
    mse = data.mean_mse.to_numpy()
    sure = data.mean_sure.to_numpy()
    mse_ci = 1.96 * data.mse_se.to_numpy()
    sure_ci = 1.96 * data.sure_se.to_numpy()
    i_oracle = int(np.argmin(mse))
    i_sure = int(np.argmin(sure))
    fig, ax = plt.subplots(figsize=(SINGLE, 2.55))
    ax.semilogx(g, mse, color="black", label="mean realized MSE")
    ax.fill_between(g, mse - mse_ci, mse + mse_ci, color="black", alpha=.12)
    ax.semilogx(g, sure, color=BLUE, label="mean fixed-parameter SURE")
    ax.fill_between(g, sure - sure_ci, sure + sure_ci, color=BLUE, alpha=.15)
    ax.scatter(g[i_oracle], mse[i_oracle], color="black", marker="s", s=22, label="oracle grid point")
    ax.scatter(g[i_sure], sure[i_sure], color=ORANGE, marker="*", s=45,
               label="mean-SURE grid point")
    ax.set(xlabel=r"smoothing parameter $\gamma$", ylabel="risk per sample")
    ax.grid(True, which="both", alpha=.22)
    ax.legend(loc="upper left")
    fig.tight_layout(pad=.2)
    save_figure(fig, out, "fig_sure_optimization")


