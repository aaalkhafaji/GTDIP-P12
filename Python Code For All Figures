def neumann_laplacian(n: int):
    d = diags([-np.ones(n - 1), np.ones(n - 1)], [0, 1], shape=(n - 1, n))
    l1 = d.T @ d
    return kron(eye(n), l1) + kron(l1, eye(n))


def synthetic_equal_edge_problem(n: int = 56):
    """Equal-edge RGB stress test with unequal channel noise."""
    rng = np.random.default_rng(SEED)
    yy, xx = np.mgrid[0:n, 0:n] / (n - 1)
    base = 0.18 + 0.55 * (xx > 0.24 + 0.52 * yy)
    base += 0.14 * np.exp(-((xx - 0.72) ** 2 + (yy - 0.27) ** 2) / 0.018)
    base = np.clip(base, 0.0, 1.0)
    truth = np.stack([base, base, base])
    sigma = np.array([0.13, 0.045, 0.16])
    noisy = np.clip(truth + rng.normal(size=truth.shape) * sigma[:, None, None], 0, 1)
    invvar = sigma ** -2
    weights = invvar / invvar.sum()
    guide = np.tensordot(weights, noisy, axes=(0, 0))
    return truth, noisy, sigma, weights, guide


def solve_quadratic_followers(noisy, guide, lap, alpha, xi, rho):
    """Interior quadratic specialization of the follower potential."""
    c, n, _ = noisy.shape
    ident = eye(n * n, format="csr")
    blocks = []
    for i in range(c):
        row = []
        for j in range(c):
            if i == j:
                row.append(ident + (alpha + xi + rho * (c - 1)) * lap)
            else:
                row.append(-rho * lap)
        blocks.append(row)
    hess = bmat(blocks, format="csr")
    lg = lap @ guide.ravel()
    rhs = np.concatenate([noisy[i].ravel() + xi * lg for i in range(c)])
    solution = spsolve(hess, rhs).reshape(c, n, n)
    return np.clip(solution, 0, 1), hess, rhs


def spectral_angle_map(estimate, truth):
    a = estimate.reshape(estimate.shape[0], -1)
    b = truth.reshape(truth.shape[0], -1)
    cosine = np.sum(a * b, axis=0) / (
        np.linalg.norm(a, axis=0) * np.linalg.norm(b, axis=0) + 1e-12
    )
    return np.rad2deg(np.arccos(np.clip(cosine, -1, 1))).reshape(truth.shape[1:])


def quadratic_diagnostics(noisy, guide, lap, alpha=0.20, xi=1.0, rho=0.05):
    solution, hess, rhs = solve_quadratic_followers(noisy, guide, lap, alpha, xi, rho)
    u_star = solution.ravel()
    u = noisy.ravel().copy()
    lmax = float(eigsh(hess, k=1, which="LA", return_eigenvectors=False)[0])
    mu = float(eigsh(hess, k=1, which="SA", return_eigenvectors=False)[0])
    tau = 2.0 / (lmax + mu)
    q = (lmax - mu) / (lmax + mu)

    def objective(v):
        return 0.5 * float(v @ (hess @ v)) - float(rhs @ v)

    p_star = objective(u_star)
    rows = []
    for k in range(120):
        grad = hess @ u - rhs
        rows.append({
            "iteration": k,
            "objective_gap": max(objective(u) - p_star, 1e-18),
            "relative_distance": np.linalg.norm(u - u_star) / np.linalg.norm(noisy.ravel() - u_star),
            "gradient_rms": np.linalg.norm(grad) / np.sqrt(grad.size),
            "theory_envelope": q ** k,
        })
        u = u - tau * grad
    data = pd.DataFrame(rows)
    if np.any(np.diff(data["objective_gap"].to_numpy()) > 1e-9):
        raise RuntimeError("The admissible-step objective trace is not monotone.")
    return data, {"mu": mu, "L": lmax, "tau": tau, "q": q}


