    parallel = (xx + yy) / np.sqrt(2)
    mismatch = (xx - yy) / np.sqrt(2)
    energy = .18 * parallel ** 2 + 2.5 * mismatch ** 2
    fig, ax = plt.subplots(figsize=(SINGLE, 2.65))
