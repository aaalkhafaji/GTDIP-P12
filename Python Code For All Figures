    p = scalar_parameters()
    a, ne, se = scalar_equilibria(p)
    y = np.linspace(0, 1, 300)
    x_react = a * p["I_R"] + (1 - a) * y
    x = np.linspace(0, 1, 300)
    y_leader = (p["lambda_G"] * p["I_G"] + p["gamma"] * x) / (p["lambda_G"] + p["gamma"])
    yy, xx = np.meshgrid(y, x)
    jl = .5 * p["lambda_G"] * (yy - p["I_G"]) ** 2 + .5 * p["gamma"] * (yy - xx) ** 2
    jse = .5 * p["lambda_G"] * (se[0] - p["I_G"]) ** 2 + .5 * p["gamma"] * (se[0] - se[1]) ** 2
    levels = jse + np.array([.002, .01, .03, .07, .14])
    fig, ax = plt.subplots(figsize=(SINGLE, 2.8))
    ax.plot(y, x_react, color=ORANGE, label=r"Follower $x^\star(y)$")
    ax.plot(y_leader, x, "--", color=BLUE, label="simultaneous Leader BR")
